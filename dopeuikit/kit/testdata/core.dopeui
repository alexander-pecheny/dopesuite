page title="Core catalog" kind="full"
  topbar title="Каталог"
    iconlink href="/x" label="Назад" "↩"

  section
    subhead "Формы"
    form id="f" dir="col" gap="md" method="post" action="/x"
      field label="Логин"
        textfield id="u" name="u" inputmode="email" pattern="[a-z]+" list="dl" required
      field label="Пароль"
        password id="p" name="p" minlength="8" maxlength="64" readonly disabled
      hiddenfield name="csrf" value="abc"
      datalist id="dl"
        option value="a" "A"
        option value="b" selected "B"
      field label="Валюта"
        suggestfield id="cur" name="cur" placeholder="EUR" maxlength="3" caps grow
      checkbox id="agree" checked " Согласен"
      radio name="kind" value="od" checked " ОД"
      radio name="kind" value="ek" " ЭК"
      fieldset
        radio name="g" value="1" " Раз"
      details open
        summary "Ещё"
        text "детали"
      row gap="sm" justify="between"
        button submit "Сохранить"
        button kind="danger" "Удалить"
        button "Отмена"
        button kind="ghost" small "…"

    empty "Ничего нет"
    muted "приглушённый блок"

    subhead "Значки, суммы, карточки"
    card dir="row" gap="sm" align="center" wrap
      listtitle "Аня"
      badge "владелец"
      badge tone="emphasis" "это вы"
      badge tone="positive" "действует"
      badge tone="negative" "отозвано"
      amount "60,00 ₽"
      amount tone="positive" "+12,30 ₽"
      amount tone="negative" "−4,00 ₽"
      amount tone="zero" "0,00 ₽"
    thumb src="/p.jpg" alt="чек" href="/p.jpg" width="120" height="96"

    table scroll
      trow
        hcell "Ключ"
        hcell "Значение"
      trow
        cell "x"
        cell (code "1")

  dialog id="dlg"
    text "нативная модалка"

  modal id="m" label="Настройки" title="Настройки" done="Готово" doneid="mdone"
    hint "Внутри модалки"
