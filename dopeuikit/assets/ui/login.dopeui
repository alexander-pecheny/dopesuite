page title="{{title}}" kind="sheet" classicscripts="login.js"
  topbar title=@login.title

  section id="step-method" data-login-redirect="{{redirect}}"
    hint @login.method.hint
    button id="tgLoginBtn" @login.method.telegram
    button kind="ghost" id="pwLoginBtn" @login.method.password
    message id="methodMessage"

  section id="step-code" hidden
    hint @login.code.link_hint
    button id="tgDeepLink" href="#" "t.me/…"
    hint @login.code.bot_hint_lead (strong id="tgBotName" "@…") @login.code.bot_hint_mid (strong id="tgCode" "…") "."
    hint @login.code.waiting
    message id="codeMessage"

  section id="step-username" hidden
    hint @login.username.hint
    form id="usernameForm"
      textfield id="tgUsername" placeholder=@login.field.username autocapitalize="none" autocomplete="username" spellcheck="false" required autofocus grow
      button submit @login.username.submit
    message id="usernameMessage"

  section id="step-link" hidden
    hint @login.link.hint
    form id="linkForm"
      password id="linkPassword" placeholder=@login.field.password autocomplete="current-password" required grow
      button submit @login.link.submit
    button kind="ghost" id="linkCancelBtn" @login.link.cancel
    message id="linkMessage"

  section id="step-password" hidden
    hint @login.password.hint
    form id="passwordForm" dir="col" autocomplete="on"
      textfield id="pwUsername" name="username" placeholder=@login.field.username autocomplete="username" spellcheck="false" autocapitalize="none" required grow
      password id="pwPassword" name="password" placeholder=@login.field.password autocomplete="current-password" required
      button submit @login.password.submit
    message id="passwordMessage"
