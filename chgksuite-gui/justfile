# The window over the chgksuite command line. It runs the CLI as a subprocess,
# so `just build` builds both and puts them side by side, which is where the
# GUI looks for it.

default:
    @just --list

build:
    mkdir -p build
    cd ../xy && go build -o ../chgksuite-gui/build/chgksuite ./cmd/chgksuite
    go build -o build/chgksuite-gui .

test: build
    CHGKSUITE="$PWD/build/chgksuite" go test ./...

fmt:
    gofmt -w .

vet:
    go vet ./...

check: fmt vet test

# A double-clickable chgksuite.app, with the CLI inside it.
app: build
    #!/usr/bin/env bash
    set -euo pipefail
    rm -rf build/chgksuite.app build/icon.iconset
    mkdir -p build/chgksuite.app/Contents/MacOS build/chgksuite.app/Contents/Resources build/icon.iconset
    for s in 16 32 64 128 256 512; do
        sips -z $s $s icon.png --out "build/icon.iconset/icon_${s}x${s}.png" >/dev/null
        sips -z $((s*2)) $((s*2)) icon.png --out "build/icon.iconset/icon_${s}x${s}@2x.png" >/dev/null
    done
    iconutil -c icns build/icon.iconset -o build/chgksuite.app/Contents/Resources/icon.icns
    rm -rf build/icon.iconset
    cp build/chgksuite-gui build/chgksuite build/chgksuite.app/Contents/MacOS/
    cp Info.plist build/chgksuite.app/Contents/Info.plist
    echo "built build/chgksuite.app"
