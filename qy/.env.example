# qy server configuration. Copy to .env (loaded by just via dotenv-load).

# HTTP port (default 9686; staging runs on 9687).
PORT=9686

# SQLite database path (default qy.db in the working directory).
QY_DB=qy.db

# Set to "production" to mark the session cookie Secure (HTTPS only).
QY_ENV=development

# This instance's base URL. Required unless QY_ENV says development.
# QY_PUBLIC_URL=https://qy.pecheny.me

# The organisers' telegram handles, comma separated, without @. They are
# written into the admins table at startup; more are added on /admin.
# QY_ADMINS=pecheny

# Login bot @handle and token from @BotFather. Leave the token empty on
# staging and in a dev checkout: two instances polling one bot split its
# login codes at random.
# QY_BOT_USERNAME=question_of_the_year_bot
QY_BOT_TOKEN=

# OpenRouter key and model for the anonymisation pass. Without a key only the
# rule pass runs.
# QY_OPENROUTER_KEY=
# QY_OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# The copy of gotquestions that `just import-gq` makes from its dump. Without
# it a nomination by link waits for its text from an admin.
# QY_GQ_DB=/var/lib/qy/gq.db

# The password account the kit's /admin/create_users page answers to
# (default "pecheny"), for staging, which has no bot.
# QY_ADMIN_USER=pecheny

QY_DEPLOY_HOST=
