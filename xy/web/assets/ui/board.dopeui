page title="Доска · xy" kind="board" scripts="dist/board.js dist/timer.js"
  topbar title="Доска"
    crumbs
      crumb home href="/" label="Все доски" "🏠"
      crumb id="boardTitle" "Доска"
    iconbtn id="notifToggle" label="События" title="События других участников" badgeid="notifBadge" aria-haspopup="true" aria-expanded="false" "🔔"
    iconbtn id="timerToggle" label="Таймер" title="Таймер ЧГК" aria-pressed="false" "⏰"

  mount id="kanban" kind="kanban" hidden

  -- unlock overlay
  modal id="unlockOverlay" label="Пароль доски" title="Пароль доски"
    form id="unlockForm" dir="col"
      password id="unlockPass" placeholder="Пароль доски" autocomplete="off" required autofocus
      button submit "Открыть"
    message id="unlockMessage"

  -- card detail overlay
  docoverlay id="cardOverlay" kind="detail"
    headrow kind="detail"
      selectfield id="cardKind" compact aria-label="Тип карточки"
        option value="question" "Вопрос"
        option value="meta" "Метаинформация"
        option value="heading" "Заголовок"
        option value="other" "Другое"
      mount id="cardDetailTitle" kind="card-title" hidden
      -- these buttons share the header row with the 38px kind-select and the
      -- icon button, so they are full height too — `small` made them 30px and
      -- nothing in the row agreed with anything else.
      -- Icons, not emoji-plus-caption: the row has to fit a phone, and an emoji
      -- keeps its own colours on every platform while an inline SVG follows the
      -- button's text colour. The words live on in title/aria-label. board.js
      -- swaps the glyphs in at boot — the vocabulary has no svg primitive.
      headactions kind="detail"
        unreaddot id="contentUnreadDot" data-edit-only title="Непрочитанные изменения"
        button id="cardLink" title="Скопировать прямую ссылку на карточку" aria-label="Ссылка на карточку" data-edit-only "🔗"
        button id="cardCopy" hidden title="Скопировать текст вопроса для тест-сессии (экранный режим)" aria-label="Копировать" "📋"
        button id="cardAddVersion" hidden title="Добавить версию — копию текущей формулировки, которую можно переписать" aria-label="Добавить версию" "⧉"
        iconbtn id="cardClose" label="Назад" "↩️"
    mount id="cardCopyMsg" kind="card-copy-msg" hidden

    -- view switch: preview (read-only) / structured fields / raw 4s text
    tabs id="cardViewTabs"
      tab id="cardTabPreview" view="preview" "Просмотр"
      tab id="cardTabFields" view="fields" "Поля"
      tab id="cardTabText" view="text" "Формат 4s"

    -- Versions of the question, when it has more than one: a second strip that
    -- scopes Просмотр and Поля to one wording. Формат 4s always shows the whole
    -- field, (PAGEBREAK)s and all — that is the escape hatch.
    mount id="cardVersions" kind="card-versions" hidden

    -- editing tools: ударение types into whichever field of Поля/Текст the caret
    -- was last in; типограф and →.4s rewrite the whole card, so they need no caret
    row id="cardEditTools" gap="sm" align="center" wrap
      button small kind="ghost" id="cardInsStress" title="Вставить знак ударения (ставится на гласную слева от курсора)" "◌́ ударение"
      button small kind="ghost" id="cardTypo" title="Типографика: кавычки-ёлочки, тире, неразрывные пробелы и дефисы, раскодирование ссылок" "типограф"
      button small kind="ghost" id="cardTo4s" title="Разобрать простой текст вопроса в формат 4s" "→.4s"

    -- Просмотр: single-card docx-style render (read-only)
    tabpanel id="cardViewPreview"
      checkbox id="cardPreviewScreen" kind="card-preview" title="Экранный режим: убрать пометки ведущему [в скобках] и ударения" " для экрана"
      mount id="cardPreviewBody" kind="card-preview-body" title="Двойной клик — редактировать"

    -- Поля: structured field editor (question cards)
    tabpanel id="cardViewFields"
      mount id="cardFields" kind="card-fields"

    -- Текст: raw 4s editor
    tabpanel id="cardViewText"
      label id="cardDescLabel" "Описание"
      editor id="cardDesc" spellcheck="false"

    row gap="sm" wrap
      button id="cardSave" "Сохранить"
      button kind="danger" id="cardDelete" data-edit-only "Удалить карточку"
    message id="cardMessage"

    label data-edit-only "Метки"
    -- The assigned labels and the add button share ONE row; the "create a new
    -- label" form is not here at all — board.js detaches it at boot and mounts it
    -- inside the add-label popup, which is the only place it is wanted.
    row gap="sm" align="center" wrap data-edit-only
      mount id="labelPicker" kind="label-picker"
      mount id="labelAddRow" kind="label-add-row"
        button kind="ghost" id="labelAddBtn" "➕ Добавить метку…"

    -- Тесты: which sittings this question was played at, each with its own
    -- labels. Separate from Метки above: a label there is the author's view, a
    -- label under a test is what the testers thought (ADR-0004).
    label data-edit-only "Тесты"
    mount id="cardPlayings" kind="card-playings" data-edit-only
    row gap="sm" align="center" wrap data-edit-only
      mount id="playingAddRow" kind="label-add-row"
        button kind="ghost" id="playingAddBtn" "➕ Отметить тестом…"
    -- Видели: every tester from every session this card is tagged with, derived
    -- and stored nowhere. Hidden until there is one.
    mount id="cardSeen" kind="card-seen" hidden data-edit-only

    form id="newLabelForm" dir="row" gap="sm"
      textfield id="newLabelName" placeholder="Новая метка" grow
      mount id="newLabelColor" kind="color-field"
      button small submit title="Создать и добавить метку" "➕"

    -- Алиас: the card's short name, shown in the list instead of its text. NOT a
    -- 4s field (its own encrypted column), so it lives out here below the views
    -- rather than inside Поля, and captureDraft reads it whichever view is open.
    -- Deliberately NOT data-edit-only, unlike every other section down here: those
    -- need a persisted card (labels, attachments, timeline), an alias does not, and
    -- hiding it would make it unsettable on the card-creation screen.
    label id="cardAliasLabel" "Алиас"
    -- The alias is its own column, saved on its OWN button fused to the input —
    -- NOT via «Сохранить», which is about the card's 4s content. The two are
    -- unrelated, and coupling them meant an alias could not be saved from the
    -- read-only Просмотр view at all. The button is data-edit-only: on a card
    -- being CREATED there is no alias column yet, so the alias rides along on the
    -- initial create instead (see cardSave), and only an existing card needs it.
    row id="cardAliasRow" gap="sm" align="center"
      textfield id="cardAlias" placeholder="короткое имя карточки — показывается в списке вместо текста" autocomplete="off" maxlength="200" grow
      button id="cardAliasSave" data-edit-only disabled title="Сохранить алиас" "Сохранить"

    -- Выписки: the comments and attachments flagged as source excerpts, counted
    -- here and shown together in one modal — the point of the flag is to have the
    -- sources at hand mid-edit without scrolling the whole лента for them.
    -- the count is a span mount, NOT a `label`: the label primitive is a section
    -- heading and carries a 24px top margin, which drops it out of line with the
    -- button beside it however the row is aligned
    row gap="sm" align="center" wrap data-edit-only
      mount id="excerptsCount" kind="excerpt-count"
      button small kind="ghost" id="excerptsView" disabled "Смотреть"

    label data-edit-only "Вложения"
    mount id="attachments" kind="attachments" data-edit-only
    row gap="sm" align="center" wrap data-edit-only
      -- no `small` on the upload button: it shares this row with the file field,
      -- and a 30px button beside a 38px field cannot line up with it
      filefield id="attachFile"
      checkbox id="attachCompress" " сжать (WebP)"
      button id="attachUpload" "Загрузить"

    label data-edit-only "Переместить / копировать"
    row gap="sm" align="center" wrap data-edit-only
      selectfield id="moveBoard" title="Доска" grow
      selectfield id="moveList" title="Список" grow
      selectfield id="movePos" title="Позиция" grow
    row gap="sm" align="center" wrap data-edit-only
      button small id="copyBtn" "Копировать"
      button small id="moveBtn" "Переместить"

    label data-edit-only "Лента " (unreaddot id="commentsUnreadDot" title="Непрочитанные комментарии")
    -- вид правок controls how desc_edit events render: краткий shows only the
    -- changed words with a little context, подробный the whole before/after.
    row gap="sm" align="center" wrap data-edit-only
      label for="feedDiffView" "Вид правок"
      selectfield id="feedDiffView" compact title="Вид правок"
        option value="brief" "краткий"
        option value="full" "подробный"
      button small kind="ghost" id="feedExpand" title="Развернуть ленту на весь экран" "⛶ Развернуть"
    mount id="timeline" kind="timeline" data-edit-only
    form id="commentForm" dir="col" data-edit-only
      editor id="commentInput" kind="comment" placeholder="Комментарий…" spellcheck="false"
      -- tag the comment with the test it came out of («на этом тесте команда
      -- споткнулась о формулировку»); hidden unless the card carries a session
      row id="commentSessionRow" gap="sm" align="center" wrap hidden
        label for="commentSession" "На тесте"
        selectfield id="commentSession" compact title="Тест, на котором это обсуждали"
      button small submit "Отправить"

  -- list preview overlay (docx-style render, JS-only)
  docoverlay id="previewOverlay" kind="doc" label="Предпросмотр списка"
    headrow
      previewtitle id="previewTitle" "Предпросмотр"
      headactions
        checkbox id="previewScreen" kind="preview" title="Экранный режим: убрать пометки ведущему [в скобках] и ударения" " для экрана"
        iconbtn id="previewClose" label="Закрыть" "×"
    mount id="previewBody" kind="preview-body"

  -- export picker: tick the formats, get one file — or a zip of all of them.
  -- Offline only .4s survives; the rest need the server to render.
  modal id="exportOverlay" label="Экспорт списка" title="Экспорт"
    form id="exportForm" dir="col"
      checkbox id="exportFmt4s" checked title="Исходник chgksuite; изображения кладутся рядом в архив" " .4s"
      checkbox id="exportFmtDocx" " .docx"
      checkbox id="exportFmtPdf" " .pdf"
      checkbox id="exportFmtPdfMobile" title="Вёрстка под узкий экран" " .pdf для телефона"
      checkbox id="exportFmtHandouts" title="Раздатки по одной на страницу, свёрстанные по размеру (split-fit)" " раздатки в pdf"
      row gap="sm" align="center" wrap
        button small kind="ghost" id="exportToggleAll" "Выбрать все"
        button submit id="exportRun" "Экспорт"
        button kind="ghost" id="exportCancel" "Отмена"
    message id="exportMessage"

  -- import picker: the package file plus how it lands on the board — one list,
  -- or (разбить по турам) one list per "## " section, linked into a group with
  -- continuous numbering and combined export
  modal id="importPickOverlay" label="Импорт пакета" title="Импорт пакета"
    form id="importPickForm" dir="col"
      filefield id="importFile" accept=".4s,.zip,.docx" required
      checkbox id="importSplitTours" title="Каждый тур станет отдельным списком; списки будут связаны в группу со сквозной нумерацией и общим экспортом" " разбить по турам"
      row gap="sm" wrap
        button submit "Импортировать"
        button kind="ghost" id="importPickCancel" "Отмена"

  -- import verification overlay: the parsed 4s source (left, editable) next to
  -- its live preview (right), so parsing mistakes can be fixed before the
  -- package becomes a list. Only .docx needs it — .4s/.zip import straight.
  docoverlay id="importOverlay" kind="doc" variant="import" label="Проверка импорта"
    headrow
      previewtitle id="importTitle" "Проверка импорта"
      headactions
        mount id="importCount" kind="import-count"
        button small id="importCommit" "Импортировать"
        iconbtn id="importClose" label="Закрыть" "×"
    split
      pane kind="src"
        editor id="importSource" kind="importsrc" spellcheck="false" aria-label="Исходник 4s"
      mount id="importPreview" kind="import-preview"

  -- handouts generation overlay: edit the chgksuite .hndt source (left) and
  -- render it to a PDF via the server (right). The PDF is ephemeral.
  docoverlay id="handoutsOverlay" kind="doc" variant="handouts" label="Генерация раздаток"
    headrow
      previewtitle "Генерация раздаток"
      headactions
        iconbtn id="handoutsClose" label="Закрыть" "×"
    split
      pane kind="src"
        -- both panes open with the same header row, so the two labels (and the
        -- textarea / pdf area under them) sit on one line across the splitter
        row gap="sm" align="center" justify="between"
          label "Источник (.hndt)"
        editor id="handoutsSource" kind="handouts" spellcheck="false"
        row gap="sm" align="center" wrap
          button small id="handoutsGenerate" "Сгенерировать PDF"
          button small kind="ghost" id="handoutsSplitFit" title="Подобрать раскладку (split-fit) и скачать zip со всеми PDF" "Split-fit"
        message id="handoutsMessage"
      pane kind="preview"
        row gap="sm" align="center" justify="between"
          label "PDF"
          button small download id="handoutsDownload" hidden "Скачать"
        mount id="handoutsPdf" kind="handouts-pdf"

  -- move / copy list overlay (within board → re-rank; other board →
  -- client-side re-encryption of the list + its cards)
  modal id="moveListOverlay" label="Переместить список" title="Переместить список" done="Закрыть" doneid="moveListClose"
    col gap="sm"
      label for="moveListBoard" "Доска"
      selectfield id="moveListBoard" title="Доска"
      label for="moveListPos" "Позиция"
      selectfield id="moveListPos" title="Позиция"
    row gap="sm" align="center" wrap
      button small id="moveListCopyBtn" "Копировать"
      button small id="moveListMoveBtn" "Переместить"
    message id="moveListMessage"

  -- lists management overlay: reorder lists (drag / position), select several
  -- and move them together, and link consecutive lists into a group
  -- (list_of_lists) with shared numbering + combined export.
  modal id="listsManageOverlay" label="Управление списками" title="Управление списками" variant="lists" done="Готово" doneid="listsManageClose"
    row gap="sm" align="center" justify="between" wrap
      button small id="listsLinkBtn" disabled title="Выберите подряд идущие списки и свяжите их в группу" "🔗 Связать списки"
      row gap="sm" align="center"
        numfield id="listsMovePos" min="1" placeholder="№" narrow
        button small kind="ghost" id="listsMoveBtn" disabled title="Переместить выбранные на указанную позицию" "Переместить выбранные"
    mount id="listsManageRows" kind="lists-manage-rows"
    message id="listsManageMessage"

  -- test sessions: the board-level panel that replaced the тест-список
  modal id="sessionsOverlay" label="Тесты" title="🧪 Тесты" variant="lists" done="Готово" doneid="sessionsClose"
    row gap="sm" align="center" justify="between" wrap
      button small id="sessionAddBtn" title="Создать тест-сессию" "＋ Новый тест"
    mount id="sessionsList" kind="sessions-list"
    message id="sessionsMessage"

  -- one session: date, optional time and zone, title, testers, announce cities
  modal id="sessionEditOverlay" label="Тест-сессия" title="Тест-сессия" variant="lists" done="Готово" doneid="sessionEditClose"
    mount id="sessionForm" kind="session-form"
    message id="sessionEditMessage"

  -- rename / recolour every label on the board (issue #25)
  modal id="labelsEditOverlay" label="Метки" title="🏷️ Метки" variant="lists" done="Готово" doneid="labelsEditClose"
    mount id="labelsEditor" kind="labels-editor"
    message id="labelsEditMessage"

  -- «Вопросы тестировали» for ONE tour: each session with how much of the tour
  -- it saw, so the custom (name those who tested most of it) can be applied
  modal id="testerListOverlay" label="Список тестеров" title="👥 Список тестеров" variant="lists" done="Готово" doneid="testerListClose"
    hint "По умолчанию отмечены те, кто видел больше половины вопросов из списка."
    mount id="testerList" kind="tester-list"
    message id="testerListMessage"

  -- members / sharing overlay
  modal id="membersOverlay" label="Участники доски" title="Участники доски" done="Готово" doneid="membersClose"
    mount id="membersList" kind="members-list"
    form id="addMemberForm" dir="row" gap="sm" hidden
      textfield id="addMemberName" placeholder="Имя пользователя" autocomplete="off" autocapitalize="none" autocorrect="off" spellcheck="false" grow
      button small submit "Добавить"
    message id="membersMessage"

  -- expanded лента: the same feed on the whole screen, flowed into columns so a
  -- long discussion can be read without scrolling a 320px-tall panel
  -- No «Лента» title: after «Развернуть» it is obvious where you are. Both
  -- labelled selects sit on ONE line (desktop has the room, and a second row
  -- would only eat into the feed); on a phone they shrink and wrap.
  docoverlay id="feedOverlay" kind="doc" variant="feed" label="Лента"
    headrow
      headactions
        -- each label+select is one nowrap unit, so when the row wraps on a phone
        -- the label never orphans from its select (two clean pairs, one each row)
        row gap="sm" align="center"
          label for="feedDiffViewFull" "Вид правок"
          selectfield id="feedDiffViewFull" compact title="Вид правок"
            option value="brief" "краткий"
            option value="full" "подробный"
        row gap="sm" align="center"
          label for="feedOrder" "Порядок"
          selectfield id="feedOrder" compact title="Порядок событий"
            option value="new" "сначала новое"
            option value="old" "сначала старое"
        iconbtn id="feedClose" label="Закрыть" "×"
    mount id="feedGrid" kind="feed-grid"

  -- thread viewer: one comment and its replies, oldest→newest (the лента itself
  -- is newest-first, but a conversation only reads top-to-bottom). Replies also
  -- stay in the flat лента; this is the place to read one exchange in order.
  modal id="threadOverlay" label="Ответы" title="Ответы" variant="wide" done="Закрыть" doneid="threadClose"
    mount id="threadBody" kind="thread"
    form id="threadForm" dir="col"
      editor id="threadInput" kind="comment" placeholder="Ответить…" spellcheck="false"
      button small submit "Ответить"
    message id="threadMessage"

  -- выписки viewer: every excerpt of the open card in one scrollable place,
  -- images inline (they are usually screenshots of the source, and opening one
  -- per tab was exactly the friction this replaces)
  modal id="excerptsOverlay" label="Выписки" title="Выписки" variant="wide" done="Закрыть" doneid="excerptsClose"
    mount id="excerptsBody" kind="excerpts"

  -- paste-image overlay
  modal id="pasteOverlay" label="Вставить изображение" title="Вставить изображение"
    form id="pasteForm" dir="col"
      textfield id="pasteName" placeholder="Имя файла" autocomplete="off" required
      checkbox id="pasteCompress" " сжать (WebP)"
      row gap="sm" wrap
        button submit "Сохранить"
        button kind="ghost" id="pasteCancel" "Отмена"

  -- unsaved-changes prompt: leaving a dirty card by any route (↩️, Escape,
  -- Android back, the backdrop, ← / → to the next card) asks rather than
  -- silently discarding, which is what every exit used to do.
  modal id="dirtyOverlay" label="Несохранённые изменения" title="Несохранённые изменения"
    hint "В карточке есть несохранённые изменения."
    row gap="sm" wrap
      button id="dirtySave" "Сохранить"
      button kind="danger" id="dirtyDiscard" "Не сохранять"
      button kind="ghost" id="dirtyCancel" "Отмена"
    message id="dirtyMessage"
