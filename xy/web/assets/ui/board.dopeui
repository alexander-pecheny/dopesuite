page title=@board.page.title kind="board" scripts="dist/board.js dist/timer.js"
  topbar title=@board.page.name
    crumbs
      crumb home href="/" icon="house" label=@board.page.home
      crumb id="boardTitle" @board.page.name
    iconbtn id="notifToggle" label=@board.bell.label title=@board.bell.title badgeid="notifBadge" aria-haspopup="true" aria-expanded="false" icon="bell"
    iconbtn id="timerToggle" icon="timer" label=@board.timer.label title=@board.timer.title aria-pressed="false"

  -- Label filter: the bar sits ABOVE the board, because it is the caption
  -- of what you are looking at. Its modal is down with the other overlays.
  mount id="filterBar" kind="filter-bar" hidden
  mount id="kanban" kind="kanban" hidden

  -- unlock overlay. The ghost "forgot password" button offers the way off a board whose content
  -- is already lost: deleting or leaving it needs the roster, never the key.
  modal id="unlockOverlay" label=@board.unlock.title title=@board.unlock.title
    form id="unlockForm" dir="col"
      password id="unlockPass" placeholder=@board.unlock.pass_placeholder autocomplete="off" required autofocus
      button submit @board.unlock.submit
    message id="unlockMessage"
    row
      button kind="ghost" id="unlockForgot" @board.unlock.forgot
    col id="unlockExit" gap="sm" hidden
      hint kind="danger" @board.unlock.exit_hint
      row
        button kind="danger" id="unlockExitBtn" @board.delete.label

  -- the Passphrase Check. No ✕ and no "later": the two ways out are typing the
  -- pass and setting a new one (passcheck.ts vetoes every other dismissal).
  modal id="passCheckOverlay" label=@board.unlock.title title=@board.passcheck.title
    col id="passCheckStep1" gap="sm"
      hint
        @board.passcheck.hint_lead
        @board.passcheck.hint_mid
      form id="passCheckForm" dir="col"
        password id="passCheckPass" placeholder=@board.unlock.pass_placeholder autocomplete="off" required
        row gap="sm" wrap
          button submit @board.passcheck.submit
          button kind="ghost" id="passCheckForgot" @board.passcheck.forgot
    col id="passCheckStep2" gap="sm" hidden
      hint @board.passcheck.saved_hint
      row gap="sm" wrap
        button kind="primary" id="passCheckBackup" @board.passcheck.backup
        button kind="ghost" id="passCheckClose" @board.actions.close
    message id="passCheckMessage"

  -- changePass ("change the board password"): the creation form again, minus the old passphrase.
  -- The device holds the key, so the change only re-wraps it.
  modal id="changePassOverlay" label=@board.changepass.title title=@board.changepass.title
    form id="changePassForm" dir="col"
      row gap="sm" align="center"
        textfield id="changePassInput" placeholder=@board.changepass.placeholder autocomplete="new-password" required grow
        iconbtn id="changePassGen" icon="dices" label=@board.changepass.generate
      muted id="changePassCopied" hidden @board.changepass.copied
      hint kind="danger" @board.changepass.danger
      checkbox id="changePassSaved" @board.changepass.saved
      row gap="sm" wrap
        button submit id="changePassSubmit" disabled @board.changepass.submit
        button kind="ghost" id="changePassCancel" @board.actions.cancel
    message id="changePassMessage"

  -- card detail overlay
  docoverlay id="cardOverlay" kind="detail"
    headrow kind="detail"
      selectfield id="cardKind" compact aria-label=@board.card.kind_label
        option value="question" @board.card.kind_question
        option value="meta" @board.card.kind_meta
        option value="heading" @board.card.kind_heading
        option value="other" @board.card.kind_other
      mount id="cardDetailTitle" kind="card-title" hidden
      -- these buttons share the header row with the 38px kind-select and the
      -- icon button, so they are full height too — `small` made them 30px and
      -- nothing in the row agreed with anything else.
      -- Icons, not emoji-plus-caption: the row has to fit a phone, and an emoji
      -- keeps its own colours on every platform while an inline SVG follows the
      -- button's text colour. The words live on in title/aria-label.
      headactions kind="detail"
        unreaddot id="contentUnreadDot" title=@board.unread.dot
        button id="cardLink" icon="link" title=@board.card.link_title aria-label=@board.card.link_label
        button id="cardCopy" hidden icon="clipboard" title=@board.card.copy_title aria-label=@board.actions.copy
        button id="cardAddVersion" hidden icon="copy" title=@board.card.add_version_title aria-label=@board.card.add_version_label
        -- Close by default; openCard swaps in "← Back" when the card was opened
        -- from a list preview, which is where closing it actually lands.
        iconbtn id="cardClose" icon="x" label=@board.actions.close
    mount id="cardCopyMsg" kind="card-copy-msg" hidden

    -- view switch: preview (read-only) / structured fields / raw 4s text
    tabs id="cardViewTabs"
      tab id="cardTabPreview" view="preview" @board.card.tab_preview
      tab id="cardTabFields" view="fields" @board.card.tab_fields
      tab id="cardTabText" view="text" @board.card.tab_text

    -- Versions of the question, when it has more than one: a second strip that
    -- scopes Preview and Fields to one wording. The 4s tab always shows the whole
    -- field, (PAGEBREAK)s and all — that is the escape hatch.
    mount id="cardVersions" kind="card-versions" hidden

    -- editing tools: the stress tool types into whichever field of Fields/Text the caret
    -- was last in; the typographer and →.4s rewrite the whole card, so they need no caret
    row id="cardEditTools" gap="sm" align="center" wrap
      button small kind="ghost" id="cardInsStress" title=@board.card.stress_title @board.card.stress_label
      button small kind="ghost" id="cardTypo" title=@board.card.typo_title @board.card.typo_label
      button small kind="ghost" id="cardTo4s" title=@board.card.to4s_title "→.4s"

    -- Preview: single-card docx-style render (read-only)
    tabpanel id="cardViewPreview"
      checkbox id="cardPreviewScreen" kind="card-preview" title=@board.card.screen_title @board.card.screen_label
      mount id="cardPreviewBody" kind="card-preview-body" title=@board.card.preview_dblclick

    -- Fields: structured field editor (question cards)
    tabpanel id="cardViewFields"
      mount id="cardFields" kind="card-fields"

    -- Text: raw 4s editor
    tabpanel id="cardViewText"
      label id="cardDescLabel" @board.card.desc_label
      editor id="cardDesc" spellcheck="false"

    row gap="sm" wrap
      button id="cardSave" @board.actions.save
      button kind="danger" id="cardDelete" @board.card.delete
    message id="cardMessage"

    label @board.labels.name
    -- The assigned labels and the add button share ONE row; the "create a new
    -- label" form is not here at all — board.js detaches it at boot and mounts it
    -- inside the add-label popup, which is the only place it is wanted.
    row gap="sm" align="center" wrap
      mount id="labelPicker" kind="label-picker"
      mount id="labelAddRow" kind="label-add-row"
        button kind="ghost" icon="plus" id="labelAddBtn" @board.card.label_add

    -- Tests: which sittings this question was played at, each with its own
    -- labels. Separate from Labels above: a label there is the author's view, a
    -- label under a test is what the testers thought (ADR-0004).
    label @board.card.playings_label
    mount id="cardPlayings" kind="card-playings"
    row gap="sm" align="center" wrap
      mount id="playingAddRow" kind="label-add-row"
        button kind="ghost" icon="plus" id="playingAddBtn" @board.card.mark_test
    -- Seen: every tester from every session this card is tagged with, derived
    -- and stored nowhere. Hidden until there is one.
    mount id="cardSeen" kind="card-seen" hidden

    form id="newLabelForm" dir="row" gap="sm"
      textfield id="newLabelName" placeholder=@board.card.new_label_placeholder grow
      mount id="newLabelColor" kind="color-field"
      button small submit icon="plus" title=@board.card.new_label_title

    -- Alias: the card's short name, shown in the list instead of its text. NOT a
    -- 4s field (its own encrypted column), so it lives out here below the views
    -- rather than inside Fields. No save button — it autosaves (saveAlias).
    label @board.card.alias_label
    textfield id="cardAlias" placeholder=@board.card.alias_placeholder autocomplete="off" maxlength="200"

    -- Excerpts: the comments and attachments flagged as source excerpts, counted
    -- here and shown together in one modal — the point of the flag is to have the
    -- sources at hand mid-edit without scrolling the whole feed for them.
    -- the count is a span mount, NOT a `label`: the label primitive is a section
    -- heading and carries a 24px top margin, which drops it out of line with the
    -- button beside it however the row is aligned
    row gap="sm" align="center" wrap
      mount id="excerptsCount" kind="excerpt-count"
      button small kind="ghost" id="excerptsView" disabled @board.card.excerpts_view

    label @board.card.attachments_label
    mount id="attachments" kind="attachments"
    row gap="sm" align="center" wrap
      -- no `small` on the upload button: it shares this row with the file field,
      -- and a 30px button beside a 38px field cannot line up with it
      filefield id="attachFile"
      checkbox id="attachCompress" @board.card.compress
      button id="attachUpload" @board.card.upload

    label @board.card.move_label
    row gap="sm" align="center" wrap
      selectfield id="moveBoard" title=@board.fields.board grow
      selectfield id="moveList" title=@board.fields.list grow
      selectfield id="movePos" title=@board.fields.position grow
    row gap="sm" align="center" wrap
      button small id="copyBtn" @board.actions.copy
      button small id="moveBtn" @board.actions.move

    label @board.card.feed_label (unreaddot id="commentsUnreadDot" title=@board.unread.comments)
    -- show narrows the feed to one kind of entry, only until the card
    -- closes; the edit-view select governs how a desc_edit renders, so it goes away in the
    -- modes that show none.
    row gap="sm" align="center" wrap
      row gap="sm" align="center"
        label for="feedFilter" @board.feed.show
        selectfield id="feedFilter" compact title=@board.feed.filter_title
          option value="all" @board.feed.opt_all
          option value="comments" @board.feed.opt_comments
          option value="edits" @board.feed.opt_edits
          option value="meta" @board.feed.opt_meta
      row id="feedDiffViewRow" gap="sm" align="center"
        label for="feedDiffView" @board.feed.diff_view
        selectfield id="feedDiffView" compact title=@board.feed.diff_view
          option value="brief" @board.feed.opt_brief
          option value="full" @board.feed.opt_full
      -- glyph only: with its caption the row wrapped onto a second line beside
      -- the two labelled selects, and the words live on in title/aria-label
      button small kind="ghost" icon="maximize-2" id="feedExpand" title=@board.feed.expand_title aria-label=@board.feed.expand_label
    mount id="timeline" kind="timeline"
    form id="commentForm" dir="col"
      editor id="commentInput" kind="comment" placeholder=@board.feed.comment_placeholder spellcheck="false"
      button small submit @board.feed.submit

  -- list preview overlay (docx-style render, JS-only)
  docoverlay id="previewOverlay" kind="doc" label=@board.preview.list
    headrow
      previewtitle id="previewTitle" @board.preview.title
      headactions
        checkbox id="previewScreen" kind="preview" title=@board.card.screen_title @board.card.screen_label
        iconbtn id="previewClose" icon="x" label=@board.actions.close
    mount id="previewBody" kind="preview-body"

  -- export picker: tick the formats, get one file — or a zip of all of them.
  -- Offline only .4s survives; the rest need the server to render.
  modal id="exportOverlay" label=@board.export.overlay_label title=@board.export.title
    form id="exportForm" dir="col"
      checkbox id="exportFmt4s" checked title=@board.export.fmt4s_title " .4s"
      checkbox id="exportFmtDocx" " .docx"
      checkbox id="exportFmtPdf" " .pdf"
      checkbox id="exportFmtPdfMobile" title=@board.export.pdf_mobile_title @board.export.pdf_mobile_label
      checkbox id="exportFmtHandouts" title=@board.export.handouts_title @board.export.handouts_label
      row gap="sm" align="center" wrap
        button small kind="ghost" id="exportToggleAll" @board.export.select_all
        button submit id="exportRun" @board.export.run
        button kind="ghost" id="exportCancel" @board.actions.cancel
    message id="exportMessage"

  -- The board-wide typographer stops here when the pass wants to add stress marks:
  -- chgk writes stress by capitalising the stressed vowel ("brAzer"), and a
  -- camel-cased compound ("GazpromInvest") is the same shape, so the editor
  -- confirms each word once for the whole board. Nothing else in the pass is reviewable.
  -- Find and replace: one replacement over the whole board, one list or one
  -- group. Every occurrence is shown with its context and ticked one by one,
  -- because the same abbreviation before a city name and after a year are two
  -- different decisions.
  modal id="replaceOverlay" label=@board.replace.title title=@board.replace.title done=@board.actions.close doneid="replaceClose"
    -- one control per line: "find" and "replace with" read as a pair, and a pair
    -- that wraps mid-row reads as neither
    row gap="sm" align="center" wrap
      selectfield id="replaceScope" compact
        option value="board" selected @board.replace.scope_board
      checkbox id="replaceCase" checked @board.replace.case
    textfield id="replaceFrom" placeholder=@board.replace.find autocomplete="off" spellcheck="false"
    textfield id="replaceTo" placeholder=@board.replace.replace_with autocomplete="off" spellcheck="false"
    mount id="replaceHits" kind="replace-hits"
    row gap="sm" align="center" wrap
      button small kind="ghost" id="replacePrev" @board.replace.prev
      muted id="replacePage"
      button small kind="ghost" id="replaceNext" @board.replace.next
    -- "Close", never "Cancel": nothing here is undone by leaving, and a run
    -- that already happened is in each card's feed, not in this dialog.
    row gap="sm" wrap
      button id="replaceRun" @board.replace.run
    message id="replaceMessage"

  modal id="accentOverlay" label=@board.accent.title title=@board.accent.title
    hint @board.accent.hint
    mount id="accentPicks" kind="accent-picks"
    row gap="sm" wrap
      button id="accentRun" @board.accent.run
      button kind="ghost" id="accentCancel" @board.actions.cancel

  -- import picker: the package file plus how it lands on the board — one list,
  -- or (split by tours) one list per "## " section, linked into a group with
  -- continuous numbering and combined export
  modal id="importPickOverlay" label=@board.importpick.title title=@board.importpick.title
    form id="importPickForm" dir="col"
      hint @board.importpick.hint
      filefield id="importFile" accept=".4s,.zip,.docx" required
      hint id="importPickWhat"
      checkbox id="importSplitTours" title=@board.importpick.split_title @board.importpick.split_label
      row gap="sm" wrap
        button submit @board.importpick.submit
        button kind="ghost" id="importPickCancel" @board.actions.cancel

  -- import verification overlay: the parsed 4s source (left, editable) next to
  -- its live preview (right), so parsing mistakes can be fixed before the
  -- package becomes a list. Only .docx needs it — .4s/.zip import straight.
  docoverlay id="importOverlay" kind="doc" variant="import" label=@board.importverify.title
    headrow
      previewtitle id="importTitle" @board.importverify.title
      headactions
        mount id="importCount" kind="import-count"
        button small id="importCommit" @board.importpick.submit
        iconbtn id="importClose" icon="x" label=@board.actions.close
    split
      pane kind="src"
        editor id="importSource" kind="importsrc" spellcheck="false" aria-label=@board.importverify.src_label
      mount id="importPreview" kind="import-preview"

  -- handouts generation overlay: edit the chgksuite .hndt source (left) and
  -- render it to a PDF via the server (right). The PDF is ephemeral.
  docoverlay id="handoutsOverlay" kind="doc" variant="handouts" label=@board.handouts.title
    headrow
      previewtitle @board.handouts.title
      headactions
        iconbtn id="handoutsClose" icon="x" label=@board.actions.close
    split
      pane kind="src"
        -- both panes open with the same header row, so the two labels (and the
        -- textarea / pdf area under them) sit on one line across the splitter
        row gap="sm" align="center" justify="between"
          label @board.handouts.src_label
        editor id="handoutsSource" kind="handouts" spellcheck="false"
        row gap="sm" align="center" wrap
          button small id="handoutsGenerate" @board.handouts.generate
          button small kind="ghost" id="handoutsSplitFit" title=@board.handouts.splitfit_title "Split-fit"
        message id="handoutsMessage"
      pane kind="preview"
        row gap="sm" align="center" justify="between"
          label "PDF"
          button small download id="handoutsDownload" hidden @board.handouts.download
        mount id="handoutsPdf" kind="handouts-pdf"

  -- move / copy list overlay (within board → re-rank; other board →
  -- client-side re-encryption of the list + its cards)
  modal id="moveListOverlay" label=@board.movelist.title title=@board.movelist.title done=@board.actions.close doneid="moveListClose"
    col gap="sm"
      label for="moveListBoard" @board.fields.board
      selectfield id="moveListBoard" title=@board.fields.board
      label for="moveListPos" @board.fields.position
      selectfield id="moveListPos" title=@board.fields.position
    row gap="sm" align="center" wrap
      button small id="moveListCopyBtn" @board.actions.copy
      button small id="moveListMoveBtn" @board.actions.move
    message id="moveListMessage"

  modal id="filterOverlay" label=@board.filter.title title=@board.filter.title done=@board.actions.done doneid="filterClose"
    mount id="filterBody" kind="filter-body"

  -- Mass action: the bar that appears once cards are ticked, and the one
  -- dialog every action runs through. The dialog IS the confirmation — it names
  -- the count, holds whatever the action needs picked, and its primary button
  -- does the thing; there is no second "really sure?" to click past.
  mount id="massBar" kind="mass-bar" hidden
  modal id="massOverlay" label=@board.mass.name title=@board.mass.name done=@board.actions.close doneid="massClose"
    mount id="massBody" kind="mass-body"
    row gap="sm" align="center" wrap
      button id="massRun" @board.mass.run
    message id="massMessage"

  -- lists management overlay: reorder lists (drag / position), select several
  -- and move them together, and link consecutive lists into a group
  -- (list_of_lists) with shared numbering + combined export.
  modal id="listsManageOverlay" label=@board.listsmanage.title title=@board.listsmanage.title variant="lists" done=@board.actions.done doneid="listsManageClose"
    row gap="sm" align="center" justify="between" wrap
      button small icon="link" id="listsLinkBtn" disabled title=@board.listsmanage.link_title @board.listsmanage.link_label
      row gap="sm" align="center"
        numfield id="listsMovePos" min="1" placeholder="№" narrow
        button small kind="ghost" id="listsMoveBtn" disabled title=@board.listsmanage.move_title @board.listsmanage.move_label
    mount id="listsManageRows" kind="lists-manage-rows"
    message id="listsManageMessage"

  -- test sessions: the board-level panel that replaced the test list
  modal id="sessionsOverlay" icon="flask-conical" label=@board.sessions.name title=@board.sessions.name variant="lists" done=@board.actions.done doneid="sessionsClose"
    row gap="sm" align="center" justify="between" wrap
      button small id="sessionAddBtn" title=@board.sessions.add_title @board.sessions.add
    mount id="sessionsList" kind="sessions-list"
    message id="sessionsMessage"

  -- one session: date, optional time and zone, title, testers, announce cities
  modal id="sessionEditOverlay" label=@board.sessionedit.title title=@board.sessionedit.title variant="lists" done=@board.actions.done doneid="sessionEditClose"
    mount id="sessionForm" kind="session-form"
    message id="sessionEditMessage"

  -- rename / recolour every label on the board (issue #25)
  modal id="labelsEditOverlay" icon="tags" label=@board.labels.name title=@board.labels.name variant="lists" done=@board.actions.done doneid="labelsEditClose"
    mount id="labelsEditor" kind="labels-editor"
    message id="labelsEditMessage"

  -- "who tested these questions" for ONE tour: each session with how much of the tour
  -- it saw, so the custom (name those who tested most of it) can be applied
  -- the panel shell: one modal for the panels that build their body in TS
  -- (tester list, author count) — panels.ts sets the title and the body
  modal id="panelOverlay" label=@board.panel.title title=@board.panel.title variant="lists" done=@board.actions.done doneid="panelClose"
    mount id="panelBody" kind="panel-body"
    message id="panelMessage"

  -- members / sharing overlay
  modal id="membersOverlay" label=@board.members.name title=@board.members.name done=@board.actions.done doneid="membersClose"
    mount id="membersList" kind="members-list"
    form id="addMemberForm" dir="row" gap="sm" hidden
      textfield id="addMemberName" placeholder=@board.members.name_placeholder autocomplete="off" autocapitalize="none" autocorrect="off" spellcheck="false" grow
      button small submit @board.members.add
    -- Join requests appear only while someone is waiting; invite links only for the owner,
    -- who is the only one allowed to mint, revoke or approve (ADR-0017).
    section id="joinRequestsSection" hidden
      subhead @board.members.requests
      mount id="joinRequests" kind="join-requests"
    section id="invitesSection" hidden
      subhead @board.members.invites
      mount id="inviteList" kind="invite-list"
      button kind="ghost" small id="newInviteBtn" @board.members.create_invite
      mount id="inviteForm" kind="invite-form"
    message id="membersMessage"

  -- expanded feed: the same feed on the whole screen, flowed into columns so a
  -- long discussion can be read without scrolling a 320px-tall panel
  -- No feed title: after "expand" it is obvious where you are. The
  -- labelled selects sit on ONE line (desktop has the room, and a second row
  -- would only eat into the feed); on a phone they shrink and wrap.
  docoverlay id="feedOverlay" kind="doc" variant="feed" label=@board.feed.title
    headrow
      headactions
        -- each label+select is one nowrap unit, so when the row wraps on a phone
        -- the label never orphans from its select (clean pairs, one each row)
        row gap="sm" align="center"
          label for="feedFilterFull" @board.feed.show
          selectfield id="feedFilterFull" compact title=@board.feed.filter_title
            option value="all" @board.feed.opt_all
            option value="comments" @board.feed.opt_comments
            option value="edits" @board.feed.opt_edits
            option value="meta" @board.feed.opt_meta
        row id="feedDiffViewFullRow" gap="sm" align="center"
          label for="feedDiffViewFull" @board.feed.diff_view
          selectfield id="feedDiffViewFull" compact title=@board.feed.diff_view
            option value="brief" @board.feed.opt_brief
            option value="full" @board.feed.opt_full
        row gap="sm" align="center"
          label for="feedOrder" @board.feed.order_label
          selectfield id="feedOrder" compact title=@board.feed.order_title
            option value="new" @board.feed.opt_new
            option value="old" @board.feed.opt_old
        iconbtn id="feedClose" icon="x" label=@board.actions.close
    mount id="feedGrid" kind="feed-grid"

  -- thread viewer: one comment and its replies, oldest→newest (the feed itself
  -- is newest-first, but a conversation only reads top-to-bottom). Replies also
  -- stay in the flat feed; this is the place to read one exchange in order.
  modal id="threadOverlay" label=@board.thread.title title=@board.thread.title variant="wide" done=@board.actions.close doneid="threadClose"
    mount id="threadBody" kind="thread"
    form id="threadForm" dir="col"
      editor id="threadInput" kind="comment" placeholder=@board.thread.placeholder spellcheck="false"
      button small submit @board.thread.submit
    message id="threadMessage"

  -- excerpts viewer: every excerpt of the open card in one scrollable place,
  -- images inline (they are usually screenshots of the source, and opening one
  -- per tab was exactly the friction this replaces)
  modal id="excerptsOverlay" label=@board.excerpts.title title=@board.excerpts.title variant="wide" done=@board.actions.close doneid="excerptsClose"
    mount id="excerptsBody" kind="excerpts"

  -- paste-image overlay
  modal id="pasteOverlay" label=@board.paste.title title=@board.paste.title
    form id="pasteForm" dir="col"
      textfield id="pasteName" placeholder=@board.paste.name_placeholder autocomplete="off" required
      checkbox id="pasteCompress" @board.card.compress
      row gap="sm" wrap
        button submit @board.actions.save
        button kind="ghost" id="pasteCancel" @board.actions.cancel

  -- unsaved-changes prompt: leaving a dirty card by any route (the back button, Escape,
  -- Android back, the backdrop, ← / → to the next card) asks rather than
  -- silently discarding, which is what every exit used to do.
  modal id="dirtyOverlay" label=@board.dirty.title title=@board.dirty.title
    hint @board.dirty.hint
    row gap="sm" wrap
      button id="dirtySave" @board.actions.save
      button kind="danger" id="dirtyDiscard" @board.dirty.discard
      button kind="ghost" id="dirtyCancel" @board.actions.cancel
    message id="dirtyMessage"
