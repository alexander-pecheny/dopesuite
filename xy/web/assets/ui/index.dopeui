page title="Мои доски · xy" kind="full" scripts="dist/index.js"
  topbar title="Доски"
    crumbs
      crumb home icon="house" label="Все доски"
      crumb "Доски"
    iconlink href="/import" icon="file-up" label="Импорт из Trello"
    iconbtn id="newBoardBtn" icon="plus" label="Новая доска"

  -- one box over three grids: boards it can name, then the questions it can
  -- quote, then the comments — a question and a discussion about it are two
  -- different answers to «где это было?»
  searchfield id="boardSearch" placeholder="Поиск по доскам, вопросам и комментариям" label="Поиск"
  mount id="boardList" kind="board-grid"
  -- both counts start hidden for the same reason as the grids: an empty line
  -- box under the board list is 20px of nothing, and it pushed the last row of
  -- boards out of view
  muted id="cardNote" hidden
  -- both result grids start hidden: they are .board-grid too, so an empty one
  -- left on the page still takes its share of the column and clips the board
  -- list mid-row. runSearch shows each one only when it has something.
  mount id="hitList" kind="board-grid" hidden
  button kind="ghost" id="moreQuestions" hidden "Показать ещё"
  muted id="commentNote" hidden
  mount id="commentList" kind="board-grid" hidden
  button kind="ghost" id="moreComments" hidden "Показать ещё"
  message id="message"

  -- create-board dialog
  modal id="createOverlay" label="Новая доска" title="Новая доска"
    form id="createForm" dir="col"
      textfield id="boardName" placeholder="Название доски" required
      -- textfield (not password) so the passphrase is visible while creating a board:
      -- typing it once, unmasked, in a private moment beats a blind mistake you can't recover from.
      -- The dice button fills a strong xkcd-style passphrase and copies it to the clipboard.
      row gap="sm" align="center"
        textfield id="boardPass" placeholder="Пароль доски (для шифрования)" autocomplete="new-password" required grow
        iconbtn id="genPassBtn" icon="dices" label="Сгенерировать пароль"
      hint "Пароль нужен для E2E-шифрования."
      hint kind="danger" "Сохраните его прямо сейчас, его нельзя будет восстановить"
      row gap="sm" wrap
        button submit "Создать"
        button kind="ghost" id="createCancel" "Отмена"
    message id="createMessage"
