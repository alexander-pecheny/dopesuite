page title=@chrome.page.index_title kind="full" scripts="dist/index.js"
  topbar title=@chrome.home.title
    crumbs
      crumb home icon="house" label=@board.page.home
      crumb @chrome.home.title
    iconlink href="/import" icon="file-up" label=@chrome.home.import_label
    iconbtn id="newBoardBtn" icon="plus" label=@chrome.home.new_board

  -- one box over three grids: boards it can name, then the questions it can
  -- quote, then the comments — a question and a discussion about it are two
  -- different answers to "where was that?"
  searchfield id="boardSearch" placeholder=@chrome.home.search_placeholder label=@chrome.home.search_label
  mount id="boardList" kind="board-grid"
  -- both counts start hidden for the same reason as the grids: an empty line
  -- box under the board list is 20px of nothing, and it pushed the last row of
  -- boards out of view
  muted id="cardNote" hidden
  -- both result grids start hidden: they are .board-grid too, so an empty one
  -- left on the page still takes its share of the column and clips the board
  -- list mid-row. runSearch shows each one only when it has something.
  mount id="hitList" kind="board-grid" hidden
  button kind="ghost" id="moreQuestions" hidden @chrome.home.more
  muted id="commentNote" hidden
  mount id="commentList" kind="board-grid" hidden
  button kind="ghost" id="moreComments" hidden @chrome.home.more
  message id="message"

  -- create-board dialog
  modal id="createOverlay" label=@chrome.home.create_title title=@chrome.home.create_title
    form id="createForm" dir="col"
      textfield id="boardName" placeholder=@chrome.home.name_placeholder required
      -- textfield (not password) so the passphrase is visible while creating a board:
      -- typing it once, unmasked, in a private moment beats a blind mistake you can't recover from.
      -- The dice button fills a strong xkcd-style passphrase and copies it to the clipboard.
      row gap="sm" align="center"
        textfield id="boardPass" placeholder=@chrome.home.pass_placeholder autocomplete="new-password" required grow
        iconbtn id="genPassBtn" icon="dices" label=@chrome.home.pass_generate
      muted id="createPassCopied" hidden @chrome.home.pass_copied
      hint @chrome.home.pass_hint
      hint kind="danger" @chrome.home.pass_warning
      checkbox id="createPassSaved" @chrome.home.pass_saved
      row gap="sm" wrap
        button submit id="createSubmit" disabled @chrome.home.create_submit
        button kind="ghost" id="createCancel" @board.actions.cancel
    message id="createMessage"

  -- copy-board dialogues: a board whose key this device hasn't got asks its
  -- passphrase first — the copy runs in the browser (decrypt → Bundle → new
  -- key), so the source must decrypt here. Then the copy form is the create
  -- form's twin: a copy is a new board under a fresh key, only its name is
  -- prefilled and the verb differs.
  modal id="copyUnlockOverlay" label=@board.unlock.title title=@board.unlock.title
    muted id="copyUnlockHint"
    form id="copyUnlockForm" dir="col"
      password id="copyUnlockPass" placeholder=@board.unlock.pass_placeholder autocomplete="off" required autofocus
      button submit @board.unlock.submit
    row gap="sm" wrap
      button kind="ghost" id="copyUnlockCancel" @board.actions.cancel
    message id="copyUnlockMessage"

  modal id="copyOverlay" label=@board.copy.label title=@board.copy.label
    form id="copyForm" dir="col"
      textfield id="copyName" placeholder=@chrome.home.name_placeholder required
      -- the same unmasked passphrase row as the create dialog: a copy is a new
      -- board, and its password deserves the same visible handling
      row gap="sm" align="center"
        textfield id="copyPass" placeholder=@chrome.home.pass_placeholder autocomplete="new-password" required grow
        iconbtn id="copyGenPassBtn" icon="dices" label=@chrome.home.pass_generate
      muted id="copyPassCopied" hidden @chrome.home.pass_copied
      hint @chrome.home.pass_hint
      hint kind="danger" @chrome.home.pass_warning
      checkbox id="copyPassSaved" @chrome.home.pass_saved
      row gap="sm" wrap
        button submit id="copySubmit" disabled @board.copy.submit
        button kind="ghost" id="copyCancel" @board.actions.cancel
    message id="copyMessage"
