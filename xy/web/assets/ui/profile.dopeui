page title=@profile.title kind="sheet" scripts="dist/profile.js"
  topbar title=@profile.name
    crumbs
      crumb home href="/" icon="house" label=@profile.home
      crumb @profile.name

  section
    hint @profile.whoami.hint_lead (strong id="whoami" "…") @profile.whoami.hint_mid

  section
    hint @profile.storage.hint_lead (strong id="storageUsed" "…") @profile.storage.hint_mid

  section id="usernameSection" hidden
    hint @profile.username.hint
    form id="usernameForm"
      textfield id="usernameValue" placeholder=@profile.username.placeholder autocomplete="username" spellcheck="false" autocapitalize="none" required grow
      button submit @profile.save
    message id="usernameMessage"

  -- The settings sit on the page with their current values showing. Each one
  -- saves as soon as it changes; its message line says so, or says why not.
  section
    field label=@profile.font.name
      selectfield id="uiFont"
        option value="noto" @profile.font.noto
        option value="inter-fix-ra" @profile.font.inter
        option value="ibm-plex-sans-fix" @profile.font.plex_sans
        option value="literata-fix" @profile.font.literata
        option value="ibm-plex-serif-fix" @profile.font.plex_serif
        option value="stix-two-text-fix" @profile.font.stix
    hint @profile.font.face_hint
    message id="fontMessage"

  section
    field label=@profile.card_title.name
      selectfield id="cardTitle"
        option value="question" @profile.card_title.question
        option value="answer" @profile.card_title.answer
    hint @profile.card_title.hint
    message id="cardTitleMessage"

  section
    field label=@profile.feed.name
      selectfield id="feedDefault"
        option value="all" @profile.feed.all
        option value="comments" @profile.feed.comments
        option value="edits" @profile.feed.edits
        option value="meta" @profile.feed.meta
    hint @profile.feed.hint
    message id="feedDefaultMessage"

  section
    field label=@profile.author.name
      textfield id="authorValue" placeholder=@profile.author.placeholder autocomplete="off" maxlength="200"
    hint @profile.author.hint
    message id="authorMessage"

  section
    field label=@profile.tz.tz_label
      textfield id="tzValue" placeholder="Europe/Moscow" autocomplete="off" maxlength="64"
    hint @profile.tz.hint
    field label=@profile.tz.cities_label
      textfield id="tzCities" placeholder=@profile.tz.cities_placeholder autocomplete="off"
    hint @profile.tz.cities_hint
    field label=@profile.tz.title_mode_label
      selectfield id="tzTitleMode"
        option value="date-title" @profile.tz.mode_date_title
        option value="title" @profile.tz.mode_title
        option value="date" @profile.tz.mode_date
    message id="tzMessage"

  section
    button kind="ghost" id="passwordBtn" @profile.password.name
    button kind="ghost" id="sizesBtn" @profile.sizes.name
    button kind="ghost" href="/profile/tokens" @profile.account.tokens
    button kind="ghost" id="logoutBtn" @profile.account.logout

  -- change-password dialog
  modal id="passwordOverlay" label=@profile.password.name title=@profile.password.name
    form id="passwordForm" dir="col"
      password id="currentPassword" placeholder=@profile.password.current autocomplete="current-password"
      password id="newPassword" placeholder=@profile.password.new autocomplete="new-password" required
      password id="confirmPassword" placeholder=@profile.password.repeat autocomplete="new-password" required
      row gap="sm" wrap
        button submit @profile.password.submit
        button kind="ghost" id="passwordCancel" @profile.cancel
    message id="passwordMessage"

  -- board sizes dialog: workspace/list width + card height, stored per user
  -- (server-side, all boards); the pseudo-board previews the proportions
  modal id="sizesOverlay" label=@profile.sizes.name title=@profile.sizes.name variant="sizes"
    mount id="sizesPreview" kind="sizes-preview"
    sliderrow id="sizesBoardW" label=@profile.sizes.board_w valueid="sizesBoardWVal" min="800" max="3200" step="50" hint=@profile.sizes.board_w_hint
    sliderrow id="sizesListW" label=@profile.sizes.list_w valueid="sizesListWVal" min="200" max="640" step="10"
    sliderrow id="sizesCardH" label=@profile.sizes.card_h valueid="sizesCardHVal" min="1" max="12" step="1" hint=@profile.sizes.card_h_hint
    sliderrow id="sizesCardFont" label=@profile.sizes.font valueid="sizesCardFontVal" min="10" max="18" step="1" hint=@profile.sizes.font_hint
    row gap="sm" align="center" justify="between"
      button small kind="ghost" id="sizesReset" @profile.sizes.reset
      button id="sizesClose" @profile.sizes.close
