page title=@chrome.page.telegram_title kind="sheet" scripts="dist/telegram.js"
  topbar title=@chrome.telegram.title

  section
    hint @chrome.telegram.why
    hint @chrome.telegram.link_hint
    button id="tgLinkDeepLink" href="#" "t.me/…"
    hint @chrome.telegram.bot_hint_lead (strong id="tgLinkBot" "@…") @chrome.telegram.bot_hint_mid (strong id="tgLinkCode" "…") "."
    hint id="tgLinkWaiting" @chrome.telegram.waiting
    message id="tgLinkMessage"
    button id="tgLinkRetry" hidden @chrome.telegram.retry
    button kind="ghost" id="tgLinkLogout" @profile.account.logout
