page title="Импорт · xy" kind="wide" scripts="dist/import.js"
  topbar title="Импорт"
    crumbs
      crumb home href="/" icon="house" label="Все доски"
      crumb "Импорт"
    iconlink href="/" icon="arrow-left" label="Все доски"

  form id="importForm" dir="col"
    section
      subhead "Из архива xy (.zip)"
      hint
        "Архив со страницы доски (☰ «Экспорт (.zip)…»). Переносится всё, что было"
        "отмечено: списки, карточки, метки, тесты, комментарии, история правок и"
        "вложения. Здесь из него получается новая доска — чтобы добавить списки к"
        "уже существующей, откройте её и возьмите там ☰ «Импорт»."
      filefield id="bundleFile" accept=".zip,application/zip"

    section
      subhead "Из Trello"
      hint
        "Импортируются карточки, списки, метки, все комментарии (без лимита в 1000)"
        "и вложения (файлы и фото). Списки, оканчивающиеся на " (code "_tests") ", становятся"
        "тест-списками."
      button kind="primary" id="trelloConnectBtn" href="#" "Подключить Trello"
      col id="trelloTokenArea" gap="sm" hidden
        hint "Нажмите «Allow», скопируйте показанный токен и вставьте его сюда."
        textfield id="trelloTokenInput" placeholder="Токен из Trello" autocomplete="off"
        button kind="ghost" small id="trelloTokenBtn" "Подтвердить токен"
      col id="trelloPickArea" gap="sm" hidden
        label for="trelloBoard" "Доска в Trello"
        selectfield id="trelloBoard"
        hint
          "«Все доски» перенесёт каждую открытую доску Trello в отдельную доску xy —"
          "все под одним паролем; названия берутся из Trello."
        button kind="ghost" small id="trelloResetBtn" "Подключить другой аккаунт"
      hint
        "Без подключения сгодится сохранённый JSON-экспорт: меню доски Trello →"
        "«Печать, экспорт и общий доступ» → «Экспортировать как JSON». Из файла"
        "берутся до 1000 последних комментариев; вложения так не переносятся."
      filefield id="trelloFile" accept=".json,application/json"

    textfield id="boardName" placeholder="Название доски (по умолчанию — из архива или из Trello)"
    -- textfield (not password): board creation is the one safe moment to show the
    -- passphrase; the dice button fills a strong one and copies it. Mirrors the create dialog.
    row gap="sm" align="center"
      textfield id="boardPass" placeholder="Пароль доски (для шифрования)" autocomplete="new-password" required grow
      iconbtn id="genPassBtn" icon="dices" label="Сгенерировать пароль"
    muted id="importPassCopied" hidden "Пароль уже скопирован"
    hint "Пароль нужен для E2E-шифрования."
    hint kind="danger" "Сохраните этот пароль прямо сейчас — восстановить его будет невозможно."
    checkbox id="importPassSaved" "Я сохранил(а) пароль в надёжное место и обещаю его не терять"
    row gap="sm" wrap
      button submit id="importBtn" disabled "Импортировать"
      button kind="ghost" href="/" "Отмена"
    message id="importMessage"
