page title=@import.page.title kind="wide" scripts="dist/import.js"
  topbar title=@import.page.name
    crumbs
      crumb home href="/" icon="house" label=@import.page.home
      crumb @import.page.name
    iconlink href="/" icon="arrow-left" label=@import.page.home

  form id="importForm" dir="col"
    section
      subhead @import.archive.subhead
      hint @import.archive.hint
      filefield id="bundleFile" accept=".zip,application/zip"

    section
      subhead @import.trello.subhead
      hint @import.trello.intro_lead (code "_tests") @import.trello.intro_mid
      button kind="primary" id="trelloConnectBtn" href="#" @import.trello.connect
      col id="trelloTokenArea" gap="sm" hidden
        hint @import.trello.token_hint
        textfield id="trelloTokenInput" placeholder=@import.trello.token_placeholder autocomplete="off"
        button kind="ghost" small id="trelloTokenBtn" @import.trello.token_submit
      col id="trelloPickArea" gap="sm" hidden
        label for="trelloBoard" @import.trello.board_label
        selectfield id="trelloBoard"
        hint @import.trello.all_hint
        button kind="ghost" small id="trelloResetBtn" @import.trello.reset
      hint @import.trello.json_hint
      filefield id="trelloFile" accept=".json,application/json"

    textfield id="boardName" placeholder=@import.board.name_placeholder
    -- textfield (not password): board creation is the one safe moment to show the
    -- passphrase; the dice button fills a strong one and copies it. Mirrors the create dialog.
    row gap="sm" align="center"
      textfield id="boardPass" placeholder=@import.board.pass_placeholder autocomplete="new-password" required grow
      iconbtn id="genPassBtn" icon="dices" label=@import.board.gen_pass
    muted id="importPassCopied" hidden @import.board.pass_copied
    hint @import.board.pass_hint
    hint kind="danger" @import.board.pass_danger
    checkbox id="importPassSaved" @import.board.pass_saved
    row gap="sm" wrap
      button submit id="importBtn" disabled @import.board.submit
      button kind="ghost" href="/" @import.board.cancel
    message id="importMessage"
