set dotenv-load := true

default: dev

# typst is linked in as a wasm module, which the Go build embeds. The 30 MB
# artifact is NOT in git — build it once with `just build-wasm` (the only step
# that needs Rust), then again only when bumping typst. Every Go recipe below
# depends on `wasm` so a fresh clone fails with an instruction, not a cryptic
# //go:embed error.
wasm_path := "internal/chgk/typstwasm/typst.wasm"

# Build the app. Assumes the typst wasm is already built (see `just build-wasm`).
build: wasm build-web
    CGO_ENABLED=0 go build -o xy-server ./cmd/xy-server

# xy-cli: the board from the shell, for an agent (docs/adr/0015). It touches no
# embedded asset and no wasm, so it needs neither guard.
cli:
    go build -o ~/.local/bin/xy-cli ./cmd/xy-cli
    @echo "собрано: ~/.local/bin/xy-cli"

# It renders PDFs and раздатки with the typst BINARY — one it is pointed at,
# else `typst` on PATH — so it needs neither the wasm nor Rust.
# The Python tool's CLI in Go (../chgksuite_go_rewrite.md), ~14 MB
chgksuite:
    go build -ldflags="-s -w" -o ~/.local/bin/chgksuite ./cmd/chgksuite
    @echo "собрано: ~/.local/bin/chgksuite ($(du -h ~/.local/bin/chgksuite | cut -f1), typst не встроен)"

# Needs the wasm built first, and comes out ~35 MB heavier (14 → 48 stripped).
# The same, with typst carried along, for a machine that has none
chgksuite-wasm: wasm
    go build -tags wasmtypst -ldflags="-s -w" -o ~/.local/bin/chgksuite ./cmd/chgksuite
    @echo "собрано: ~/.local/bin/chgksuite ($(du -h ~/.local/bin/chgksuite | cut -f1), typst внутри)"

# The shared toolchain (root ADR-0001) builds the gitignored dist trees the Go
# build embeds (xy's own + the kit's) — so every compiling recipe depends on it.
build-web:
    cd .. && just build-web xy uikit

# Compile typst to wasm32-wasip1 and drop the artifact where //go:embed wants it.
# Needs Rust: rustup target add wasm32-wasip1
# One-time per clone, and once per typst bump (typst-wasm/Cargo.toml).
# Links with thin LTO (typst-wasm/Cargo.toml) and takes ~4 min. Fat LTO peaks at
# 4.9 GB RSS and gets OOM-killed (bare SIGKILL) on an 8 GB box; it would buy ~9%
# on pool startup and nothing per render. If you ever want it on a big machine:
#   CARGO_PROFILE_RELEASE_LTO=fat just build-wasm
build-wasm:
    #!/usr/bin/env bash
    set -euo pipefail
    cargo build --release --target wasm32-wasip1 --manifest-path typst-wasm/Cargo.toml
    cp typst-wasm/target/wasm32-wasip1/release/typst_wasm.wasm {{wasm_path}}
    ls -lh {{wasm_path}}

# Guard: the embedded artifact must exist before anything compiles the Go tree.
[private]
wasm:
    #!/usr/bin/env bash
    [ -f {{wasm_path}} ] && exit 0
    echo "missing {{wasm_path}} — run 'just build-wasm' once (needs Rust + the wasm32-wasip1 target)" >&2
    exit 1

dev: wasm build-web
    go run ./cmd/xy-server

fmt:
    #!/usr/bin/env bash
    set -euo pipefail
    mapfile -t files < <(find cmd internal -type f -name '*.go')
    ((${#files[@]} == 0)) || gofmt -w "${files[@]}"

vet: wasm build-web
    go vet ./...

tidy-check:
    go mod tidy -diff

# Go tests + frontend (deno) tests; typecheck gates here, not in build-web.
test: wasm build-web
    cd .. && just typecheck
    go test ./...
    deno test --parallel jstest/

# Frontend unit tests only (run against the built dist — see build-web).
test-js: build-web
    deno test --parallel jstest/

# The kit's guard (root justfile) covers only kit/tags_gen.go; the overlay's
# tags_gen.go goes just as stale when vocab.json (ours or the kit's) changes,
# and web/ts/markers_gen.ts when fsource's marker table does.
generate-check:
    #!/usr/bin/env bash
    set -euo pipefail
    # Compare each regenerated file against what was on disk, NOT against HEAD:
    # a git diff also fires when vocab.json and tags_gen.go are both edited
    # correctly but not yet committed, which makes pre-commit unusable mid-change.
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    rc=0
    for target in "./internal/ui internal/ui/tags_gen.go" \
                  "./internal/chgk/fsource web/ts/markers_gen.ts"; do
      set -- $target
      gentarget=$1 file=$2
      cp "$file" "$tmp/before"
      go generate "$gentarget"
      if ! diff -q "$tmp/before" "$file" >/dev/null; then
        echo "$file is stale w.r.t. its source: run 'go generate $gentarget'" >&2
        diff "$tmp/before" "$file" >&2 || true
        rc=1
      fi
    done
    exit $rc

# check cannot see what only the monorepo can: the kit's and dopecore's gates,
# and class-check, which needs both apps' TypeScript and the shared core.css at
# once. Landing a red repo-wide gate is what this split is here to stop, so
# pre-commit below is the one to run before a commit.
#
# This module's own gate: fast, and all you need mid-change.
check:
    just fmt
    just vet
    just tidy-check
    just generate-check
    just test

# The whole repo, from wherever you are.
pre-commit:
    cd .. && just pre-commit

# Mint a one-shot registration invite and print it. Usage: just invite [days]
invite days='7': wasm build-web
    go run ./cmd/xy-server invite {{days}}

# Build + deploy xy via the monorepo's ../deploy.py. One unit: the login bot
# polls inside the server (XY_BOT_TOKEN in /etc/xy.env).
deploy *args: wasm build-web
    python3 ../deploy.py --target xy-server {{args}}

# Staging at xytest.pecheny.me: a copy of prod's DB, same box, no bot.
# Release here first whenever the change touches the schema or a migration.
deploy-staging *args: wasm build-web
    python3 ../deploy.py --target xytest {{args}}
