   "kind": "comment",
   "raw": "{\"a\":1}",
   "want": {
    "kind": "comment",
    "text": "{\"a\":1}",
    "images": []
   }
  },
  {
   "name": "the marker without its text is a typed comment",
   "kind": "comment",
   "raw": "{\"xy\":1}",
   "want": {
    "kind": "comment",
    "text": "{\"xy\":1}",
    "images": []
   }
  },
  {
   "name": "another marker value is a typed comment",
