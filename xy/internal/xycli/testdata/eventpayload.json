{
 "_comment": "Timeline event payloads, plaintext. Read by internal/xycli/eventpayload_test.go and jstest/eventpayload.test.js; edit by hand. decode: what a stored row reads as, historic shapes included. encode: the exact bytes a writer produces.",
 "decode": [
  {
   "name": "a plain comment",
