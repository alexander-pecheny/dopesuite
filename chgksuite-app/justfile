# The desktop app. It embeds xy's frontend and typst, so it needs the same
# generated files xy does: the web dist trees and chgksuite's typst.wasm.

# The fork links for macOS 11; without this, cgo compiles for the running OS
# and the linker warns about every object.
export MACOSX_DEPLOYMENT_TARGET := "11.0"

default:
    @just --list

build:
    cd ../xy && just build-web wasm
    go build -o build/chgksuite .

run: build
    ./build/chgksuite

fmt:
    gofmt -w .

vet:
    go vet ./...

test:
    go test ./...

check: fmt vet test

# A double-clickable chgksuite.app, unsigned. Signing and notarising come later.
app: build
    #!/usr/bin/env bash
    set -euo pipefail
    rm -rf build/chgksuite.app build/icon.iconset
    mkdir -p build/chgksuite.app/Contents/MacOS build/chgksuite.app/Contents/Resources build/icon.iconset
    for s in 16 32 64 128 256 512; do
        sips -z $s $s ../chgksuite-gui/icon.png --out "build/icon.iconset/icon_${s}x${s}.png" >/dev/null
        sips -z $((s*2)) $((s*2)) ../chgksuite-gui/icon.png --out "build/icon.iconset/icon_${s}x${s}@2x.png" >/dev/null
    done
    iconutil -c icns build/icon.iconset -o build/chgksuite.app/Contents/Resources/icon.icns
    rm -rf build/icon.iconset
    cp build/chgksuite build/chgksuite.app/Contents/MacOS/
    cp Info.plist build/chgksuite.app/Contents/Info.plist
    echo "built build/chgksuite.app"
