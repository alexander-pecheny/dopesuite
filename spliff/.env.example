# Spliff server configuration. Copy to .env (loaded by just via dotenv-load).

# HTTP port for the server (default 9674).
PORT=9674

# SQLite database path (default spliff.db in the working directory).
SPLIFF_DB=spliff.db

# Where Photos are kept. The bytes are files on disk, not rows in SQLite, so a
# backup has two halves and a restore needs both — see README.md.
SPLIFF_BLOBS=blobs

# Set to "production" to mark the session cookie Secure (HTTPS only).
SPLIFF_ENV=development

# This instance's own base URL — every link a telegram DM carries is built from
# it. REQUIRED unless SPLIFF_ENV says development: guessing a default would send
# your Members somewhere else.
# SPLIFF_PUBLIC_URL=https://spliff.example.org

# Login bot @handle, for the t.me deep link the login page offers. REQUIRED for
# telegram login: without it the server reports telegram as misconfigured and
# offers the password form instead, saying so.
# SPLIFF_BOT_USERNAME=spliff_pecheny_bot

# Token from @BotFather. The server IS the login bot: an instance with a token
# polls Telegram, an instance without one does not, and does not offer telegram
# login. Leave it EMPTY on staging and in a dev checkout — a token is a claim on
# every login code sent to that bot, and two instances holding the same one
# split them at random.
SPLIFF_BOT_TOKEN=

# The username the /admin tooling answers to (default "pecheny").
# SPLIFF_ADMIN_USER=pecheny

# `just deploy` (deploy.py): ssh target of the VPS. The other deploy knobs have
# working defaults — see deploy.py.
SPLIFF_DEPLOY_HOST=
