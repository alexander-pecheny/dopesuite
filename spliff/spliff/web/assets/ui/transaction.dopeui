page title=@page.transaction.title kind="wide" scripts="dist/transaction.js"
  topbar
    crumbs
      crumb home href="/" icon="house" label=@page.common.home
      crumb id="groupCrumb" href="/" @page.group.title
      crumb id="txCrumb" @page.transaction.title

  section
    form id="txForm" dir="col"
      field label=@page.transaction.description
        textfield id="description" placeholder=@page.transaction.description_placeholder required autofocus grow
      row gap="sm" wrap align="end"
        field label=@page.transaction.day grow
          textfield id="day" required grow
        field label=@page.transaction.currency grow
          suggestfield id="currency" caps grow
          hint id="currencyError" kind="danger" hidden
        field label=@page.transaction.total grow
          textfield id="total" inputmode="decimal" placeholder="0.00" required grow
      hint id="rateLine" hidden
      -- The two questions a bill answers, each its own block: who handed the
      -- money over, and who it was for. Each is a table of rows a person adds
      -- and deletes — one row, one person, one amount — because that is also
      -- exactly what is stored.
      --
      -- One under the other at every width. A row of four cells is as narrow as
      -- it is going to get, and two of those tables side by side on a 44rem
      -- page leave the name — the only cell that can flex — at a few
      -- characters.
      col gap="md"
        col gap="sm"
          subhead @page.transaction.who_paid
          hint @page.transaction.who_paid_hint
          mount id="payerBody" kind="transaction-payers"
          row gap="sm" wrap
            button kind="ghost" id="addPayer" icon="plus" @page.transaction.add_row
          hint id="paidLine"
        col gap="sm"
          subhead @page.transaction.for_whom
          hint @page.transaction.for_whom_hint
          mount id="shareBody" kind="transaction-shares"
          row gap="sm" wrap
            button kind="ghost" id="addShare" icon="plus" @page.transaction.add_row
            button kind="ghost" id="everyoneBtn" icon="users" @page.transaction.add_everyone
            button kind="ghost" id="splitBtn" icon="calculator" @page.transaction.split_evenly
      hint id="totalsLine"
      row gap="sm" wrap
        button kind="primary" submit id="saveBtn" @common.save
        button kind="ghost" id="cancelBtn" @common.cancel
        button kind="danger" id="deleteBtn" hidden icon="trash-2" @page.transaction.delete
        button kind="ghost" id="restoreBtn" hidden @page.transaction.restore
    message id="message"

  section id="photoSection" hidden
    subhead @page.transaction.photos
    mount id="photos" kind="transaction-photos"
    empty id="photosEmpty" hidden @page.transaction.no_photos
    row gap="sm" align="center" wrap
      filefield id="photoInput" accept="image/*"
      button kind="ghost" id="uploadBtn" icon="paperclip" @page.transaction.upload
    message id="photoMessage"

  section id="historySection" hidden
    subhead @page.transaction.history
    mount id="history" kind="transaction-history"
